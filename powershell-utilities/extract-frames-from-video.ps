<#
.SYNOPSIS
    Extracts specific frames from a video using FFmpeg based on target timestamps.

.DESCRIPTION
    Follows Clean Architecture by separating filesystem resolution, filter generation, 
    and application execution. Utilizes array splatting to treat arguments as structured data.
#>

# ==========================================
# 1. Domain Logic: Filter Generation
# ==========================================
function Get-FFmpegSelectFilter {
    param (
        [Parameter(Mandatory=$true)]
        [int[]]$TargetSeconds
    )
    
    # Iterate through the array to build individual statements
    $FilterStatements = foreach ($Sec in $TargetSeconds) {
        "lt(prev_pts*TB,$Sec)*gte(pts*TB,$Sec)"[cite: 1]
    }
    
    # The script uses -join to automatically build the + chain for you[cite: 1]
    return "select='$($FilterStatements -join "+")'"[cite: 1]
}

# ==========================================
# 2. Infrastructure: Filesystem Resolver
# ==========================================
function Resolve-VideoPath {
    param (
        [Parameter(Mandatory=$true)]
        [string]$Path
    )
    
    # Shifts from raw strings to strict FileInfo objects to guarantee the file exists
    $ResolvedFile = Get-Item -Path $Path -ErrorAction Stop
    return $ResolvedFile.FullName
}

# ==========================================
# 3. Application Use Case: Coordinator
# ==========================================
function Invoke-CoralLarvaeExtraction {
    param (
        [string]$VideoName = "input_video.mp4",
        [int[]]$TargetSeconds = @(2, 5, 10, 15, 18),
        [string]$OutputPattern = "%03d-fertilized-2022-07-25.png"
    )

    try {
        # A. Resolve Infrastructure
        $ValidatedVideoPath = Resolve-VideoPath -Path $VideoName

        # B. Generate Domain Filter
        $FilterString = Get-FFmpegSelectFilter -TargetSeconds $TargetSeconds

        # C. Define Structured Arguments (Splatting)
        $FFmpegArgs = @(
            "-i", $ValidatedVideoPath,
            "-filter:v", $FilterString,
            "-fps_mode", "passthrough",
            $OutputPattern
        )

        Write-Host "Starting FFmpeg extraction pipeline..." -ForegroundColor Cyan

        # D. Execute Cleanly via Call Operator (&)
        & ffmpeg @FFmpegArgs -loglevel verbose[cite: 1]
        
        Write-Host "Extraction completed successfully." -ForegroundColor Green
    }
    catch {
        Write-Error "Pipeline failed: $_"
    }
}

# --- Execution Example ---
# Invoke-CoralLarvaeExtraction -VideoName "coral_sample.mp4"
